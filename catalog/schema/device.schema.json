{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardpoint device card",
  "description": "One device model: how to recognise it, what it can do, and how risky each change is. Cards are data only and can never carry a command or a script.",
  "type": "object",
  "required": [
    "card",
    "device",
    "match",
    "capability"
  ],
  "additionalProperties": false,
  "properties": {
    "card": {
      "const": 1
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "vendor",
        "name",
        "kind",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "vendor": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "keyboard",
            "mouse",
            "laptop",
            "desktop",
            "display",
            "dock",
            "audio",
            "cooling",
            "lighting",
            "storage",
            "other"
          ]
        },
        "summary": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "match": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "bus"
        ],
        "additionalProperties": false,
        "properties": {
          "bus": {
            "enum": [
              "usb",
              "bluetooth",
              "builtin",
              "display",
              "audio"
            ]
          },
          "vendor_id": {
            "type": "integer"
          },
          "product_id": {
            "type": "integer"
          },
          "usage_page": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": [
              "any",
              "macos",
              "linux",
              "windows"
            ]
          },
          "what": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "capability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "risk",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z_]+$"
          },
          "adapter": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "risk": {
            "enum": [
              "read",
              "reversible",
              "guarded",
              "gated"
            ]
          },
          "privacy": {
            "enum": [
              "open",
              "aggregate",
              "presence"
            ]
          },
          "params": {
            "type": "object"
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "step": {
            "type": "number"
          },
          "choices": {
            "type": "array",
            "minItems": 1
          },
          "note": {
            "type": "string"
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "status",
                "platform"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "tested",
                    "observed",
                    "imported",
                    "unverified"
                  ]
                },
                "platform": {
                  "enum": [
                    "macos",
                    "linux",
                    "windows"
                  ]
                },
                "os": {
                  "type": "string"
                },
                "firmware": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "by": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "keys": {
      "type": "object",
      "required": [
        "numbering",
        "matrix",
        "leds",
        "grid"
      ],
      "additionalProperties": false,
      "description": "For keyboards: how key numbers, switch positions and lights line up. One entry per key, in key-number order.",
      "properties": {
        "numbering": {
          "type": "string"
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          }
        },
        "leds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "grid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
